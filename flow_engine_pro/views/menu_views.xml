<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Top Menu -->
        <menuitem id="menu_workflow_engine_root"
                  name="Flow Engine Pro"
                  web_icon="flow_engine_pro,static/description/icon.png"
                  groups="group_flow_user"
                  sequence="200"/>

        <!-- App Menu -->
        <menuitem id="menu_workflow_diagrams"
                  name="Diagrams"
                  parent="menu_workflow_engine_root"
                  action="action_open_flow_ide"
                  groups="group_flow_user"
                  sequence="10"/>

        <!-- Native Odoo list/form for search, filters, group-by and
             reporting - the canvas IDE (above) is the primary editing
             surface, this is for finding/analyzing diagrams (user request
             2026-09-09). -->
        <menuitem id="menu_workflow_diagram_list"
                  name="Reports"
                  parent="menu_workflow_engine_root"
                  action="action_workflow_diagram"
                  groups="group_flow_user"
                  sequence="20"/>

        <!-- Correction 2026-09-10: this was briefly gated on
             group_flow_manager alone, on the assumption that would let a
             Flow Manager who isn't a System Administrator in too. That
             doesn't work and isn't safe to make work: the action's
             res_model is res.config.settings, Odoo core's SHARED
             settings model, and every Odoo install restricts it to
             base.group_system only (base/security/ir.model.access.csv) -
             not something this module controls. Granting a non-admin
             group real access to res.config.settings would expose every
             other installed module's settings, not just this one's, so
             the menu goes back to base.group_system. group_flow_manager
             still matters for diagram-level delete rights - see
             ir.model.access.csv - it just can't unlock this particular
             page. -->
        <menuitem id="menu_workflow_settings"
                  name="Settings"
                  parent="menu_workflow_engine_root"
                  action="action_flow_engine_settings"
                  groups="base.group_system"
                  sequence="100"/>
    </data>
</odoo>
