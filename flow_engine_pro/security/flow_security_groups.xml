<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dedicated category so these groups show under Settings >
             Users & Companies > Groups as their own section, instead of
             riding on base.group_user's blanket access (user request
             2026-09-09: "make sure it properly follows Odoo's security
             conventions - read/write/create"). Odoo 17/18 put category_id
             directly on res.groups - no res.groups.privilege model here
             (that's an Odoo 19-only reorg; see the 19.0 branch's version
             of this file for that variant). -->
        <record id="module_category_flow_engine" model="ir.module.category">
            <field name="name">Flow Engine Pro</field>
            <field name="description">Access to the Flow Engine Pro diagram editor.</field>
            <field name="sequence">50</field>
        </record>

        <!-- User: middle tier. Can open the IDE and view/edit the
             content of diagrams that already exist (rename, redraw,
             reshape, restyle) but cannot create a new diagram record or
             delete one - those are Manager-only actions.
             Update 2026-09-10 (user request): tightened from
             "create/edit" to "view/edit only, no create, no delete" per
             ir.model.access.csv (perm_create=0, perm_unlink=0 on
             workflow.diagram/node/edge for this group). The node/edge
             records that shadow a diagram's canvas_data JSON are kept in
             sync via _sync_canvas_data(), which now runs as sudo() so a
             User editing an existing diagram's shapes doesn't hit an
             AccessError from that internal create/write/unlink. -->
        <record id="group_flow_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_flow_engine"/>
            <field name="comment">Can open Flow Engine Pro and view/edit existing diagrams (rename, redraw, restyle). Cannot create new diagrams or delete any.</field>
        </record>

        <!-- Manager: full control. Implies User, plus create and delete
             on diagrams - the two actions withheld from User.
             Correction 2026-09-10: this does NOT unlock the global
             Settings page - that action's res_model is
             res.config.settings, which every Odoo install restricts to
             base.group_system only (a core ACL this module doesn't
             control and shouldn't override, since it's shared by every
             installed module's settings, not just this one's). The
             Settings menu stays gated on base.group_system directly -
             see menu_views.xml. -->
        <record id="group_flow_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_flow_engine"/>
            <field name="implied_ids" eval="[(4, ref('group_flow_user'))]"/>
            <field name="comment">Full access: everything a User can do, plus create new diagrams and delete any diagram.</field>
        </record>

        <!-- Every System Administrator automatically becomes a Flow
             Engine Manager too (full create/delete access, in addition
             to the Settings access base.group_system already carries on
             its own). Regular employees need one of the two groups above
             explicitly assigned to them. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_flow_manager'))]"/>
        </record>
    </data>
</odoo>
